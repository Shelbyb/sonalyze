# Spotify Developer API Credentials
# Dashboard: https://developer.spotify.com/dashboard
# Redirect URIs:
#   Local: http://localhost:3000/api/auth/callback/spotify
#   Production: https://sonalyze.daywalker.dev/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Authentication Secret (generate with `openssl rand -base64 48`)
NEXTAUTH_SECRET=your-secure-random-nextauth-secret-min-32-chars
NEXTAUTH_URL=https://localhost:3000

# Optional Last.fm API Key (for playlist recommendations & acoustic analysis without Spotify extended access)
# Get a free API key at: https://www.last.fm/api/account/create
# Not secret: Last.fm API keys are shared/public (NEXT_PUBLIC_ is shipped to the browser).
# Leave as-is to use the built-in shared key, or supply your own for isolated quota.
LASTFM_API_KEY=your_lastfm_api_key
NEXT_PUBLIC_LASTFM_API_KEY=your_lastfm_api_key

# Daywalker Service Authorization (Free: https://auth.daywalker.dev/signup?service=sonalyze)
DAYWALKER_API_KEY=your_daywalker_api_key_or_enc_token

# Public origin of this app.
# from server config, in order: APP_URL, NEXTAUTH_URL, VERCEL_URL,
# SITE_URL, PUBLIC_URL. Internal/IP hosts (0.0.0.0, localhost, 127.x, ::1, bare IPs) are never used.
# Production: https://sonalyze.daywalker.dev. Leave empty locally.
APP_URL=https://sonalyze.daywalker.dev

# Secret. Ed25519 key that signs validate requests with RFC 9421 / RFC 9530 HTTP Message Signatures.
# Accepts base64 PKCS#8 DER, PEM, or raw seed.
DAYWALKER_SIGNING_KEY=
DAYWALKER_KEY_ID=


# Optional: Daywalker Public Key for zero-egress offline JWT token lease validation
DAYWALKER_PUBLIC_KEY=

# Optional encryption secret override (defaults to NEXTAUTH_SECRET)
DAYWALKER_ENCRYPTION_KEY=

# Storage mode: `browser` (default, localStorage) or `postgres`.
# If unset, postgres is used automatically when DATABASE_URL is set.
STORAGE_MODE=browser

# Optional Postgres connection string. Enables synced preferences, listening history and track tags.
# Migrations run automatically on container start.
# DATABASE_URL=postgres://<user>:<password>@localhost:5432/<database>

# Optional read-only replica. Reads (history, tags) use it when set; writes always use DATABASE_URL.
# DATABASE_READ_URL=postgres://<user>:<password>@localhost:5432/<database>
