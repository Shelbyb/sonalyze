# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# Add Redirect URIs:
# - Local dev: http://localhost:3000/api/auth/callback/spotify
# - Production
    - No custom domain: https://<your-app-domain>.ondigitalocean.app/api/auth/callback/spotify
    - Custom domain: https://your-domain.com
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_generated_via_openssl
# In local development:
NEXTAUTH_URL=http://localhost:3000
# In DigitalOcean App Platform, set NEXTAUTH_URL to your App URL (e.g. ${APP_URL} or https://your-domain.com)
