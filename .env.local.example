# Spotify Developer API Credentials
# Dashboard: https://developer.spotify.com/dashboard
# Redirect URIs:
#   Local: http://localhost:3000/api/auth/callback/spotify
#   Production: https://sonalyze.daywalker.dev/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Daywalker Service Authorization
# Portal & Docs: https://auth.daywalker.dev/docs
DAYWALKER_API_KEY=your_daywalker_api_key_or_enc_token
DAYWALKER_SERVICE_SLUG=sonalyze
DAYWALKER_AUTH_URL=https://auth.daywalker.dev
# Public origin of this app. Daywalker identity (signing domain + Origin headers) is resolved
# from server config, in order: DAYWALKER_SIGNING_DOMAIN, APP_URL, NEXTAUTH_URL, VERCEL_URL,
# SITE_URL, PUBLIC_URL. Internal/IP hosts (0.0.0.0, localhost, 127.x, ::1, bare IPs) are never used.
# Production: https://sonalyze.daywalker.dev. Leave empty locally.
APP_URL=
# Secret. Ed25519 key that signs validate requests (X-Daywalker-* headers) so domain allowlist
# entries (e.g. *.daywalker.dev) match from any host/CDN. Public key is served at
# /.well-known/daywalker-keys.json. Accepts base64 PKCS#8 DER, PEM, or enc:v1: encrypted.
# Generate: openssl genpkey -algorithm ed25519 -outform DER | base64
DAYWALKER_SIGNING_KEY=
# Hostname the signature is issued for; must serve the JWKS above. Takes precedence over APP_URL.
# Production: sonalyze.daywalker.dev. Leave empty locally (requests go out unsigned).
DAYWALKER_SIGNING_DOMAIN=
# Optional encryption secret override (defaults to NEXTAUTH_SECRET)
DAYWALKER_ENCRYPTION_KEY=
